{
  "name": "Phantom Company",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": {
      "label": "Game"
    },
    "8080": {
      "label": "API"
    }
  },
  "postCreateCommand": "npm --prefix frontend ci && cd frontend && npx playwright install --with-deps chromium && cd .. && ./backend/gradlew --project-dir backend test",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle"
      ],
      "settings": {
        "gradle.nestedProjects": true
      }
    }
  }
}
